# Payout address. zpool credits accepted shares here - this is where the money lands.
# Any BTC address works; an exchange deposit address is fine.
POOL_USER=your-btc-address

# Pool coordinates. Ports come from https://zpool.ca/api/status
# minotaurx pays the most per browser hash today; re-check with scripts/rank-algos.ts.
POOL_HOST=minotaurx.mine.zpool.ca
POOL_PORT=7019
POOL_PASS=c=BTC

# Shares a listing must accumulate before it appears on the board.
# This is the whole anti-spam mechanism: listing costs the same currency as competing.
VISIBILITY_THRESHOLD=600

# Origins allowed to call the API and open a mining socket, comma separated.
# Leave empty in production and same-origin only is allowed. This is a security
# control: without it any website could mine on its visitors' CPUs against this
# pool account, skipping the consent banner.
# For local development: ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=

# New listings allowed per IP per minute.
RATE_MAX=5

# Required for DELETE /api/listings/:id. Leave empty to disable takedowns entirely.
ADMIN_TOKEN=

DB_PATH=data/outmine.sqlite
PORT=3000

# Your domain, used by Caddy for TLS.
SITE_ADDRESS=outmine.example.com
