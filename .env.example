# Every value below is optional except POOL_USER. Defaults are in
# packages/server/src/config.ts, which validates them at startup: a mistyped number
# stops the server rather than silently becoming NaN.

# --- pool ---------------------------------------------------------------------

# Payout address. zpool credits accepted shares here - this is where the money lands.
# Any BTC address works; an exchange deposit address is fine. Required: mining to an
# empty user credits nobody and nothing else would complain.
POOL_USER=your-btc-address

# Which proof-of-work to mine, and where. These three must agree: mining one
# algorithm at another one's pool is accepted, handed work, and rejected share by
# share. The server refuses to start if the host names a different known algorithm.
#
# Measured here, one browser thread: rinhash 14,000 H/s against minotaurx 900 H/s.
# That 15.6x is ours and certain; zpool also advertises 36x the rate per unit for
# rinhash, which does not survive a sanity check - only scripts/measure-yield.ts does.
# Re-check the hashrates with `bun run bench` and the money with
# scripts/measure-yield.ts before changing this.
POOL_ALGO=rinhash
POOL_HOST=rinhash.mine.zpool.ca
POOL_PORT=7444
POOL_PASS=c=BTC

# How many miners share one pool socket is decided at runtime, not here: the server
# watches how often the pool credits a share on each socket and moves the number until a
# browser sees one about every POOL_TARGET_SHARE_SECONDS. The two settings below are the
# bounds it works inside.
#
# It has to be measured because vardiff sets it. The pool holds a *connection* to a few
# submits a minute whatever hashrate is behind it, so the wait one miner sees is roughly
# that interval times the miners sharing the socket - and one socket per miner is a few
# hundred connections from one address, which is how a pool ban starts.
MINERS_PER_CONNECTION=64
POOL_TARGET_SHARE_SECONDS=90

# Ceiling on sockets held against the pool. Past this, mining is refused rather than
# risking a ban that would stop everyone earning. The controller stays well under it in
# normal weather; it is the brake, not the setting.
MAX_POOL_CONNECTIONS=128

# How long the server stops taking on new miners after the pool drops us or errors.
# A controller that only ever opens connections is how one address earns a ban.
POOL_BACKOFF_MS=60000

# Jobs remembered per connection, so a share that raced a job switch is dropped
# locally instead of being sent and rejected.
JOB_HISTORY=3

# Consecutive unaccepted submits before a miner is cut off. Counting rejects alone is
# not enough: a pool that has had enough simply stops replying.
MAX_BAD_SUBMITS=10

# How long an empty pool socket is held before closing, and the shortest gap between
# two "mine" messages from one socket. Both exist to keep connection churn off the
# pool: closing on the last miner leaving makes every listing switch a fresh connect,
# and a client repeating that fast enough looks like a connection flood from us.
POOL_IDLE_MS=30000
MINE_COOLDOWN_MS=2000

# --- board --------------------------------------------------------------------

# Shares a listing must accumulate before it appears on the board. This is the whole
# anti-spam mechanism: listing costs the same currency as competing.
VISIBILITY_THRESHOLD=600

# Points a listing needs before its owner may upload an icon in place of the letter
# avatar. A logo is the loudest thing on a row, so it is earned in the currency the
# board runs on - and the gate keeps an upload form off a listing anyone can create
# with one POST. Set to 0 to allow it from the start.
ICON_MIN_POINTS=2000

BOARD_ENTRIES=50
BOARD_PENDING_ENTRIES=20
BOARD_TRENDING_ENTRIES=10
BOARD_FEED_ENTRIES=15

# How often a changed board is pushed to everyone, and how often in-memory counters
# are written to SQLite.
BOARD_BROADCAST_MS=2000
FLUSH_MS=30000

MAX_NAME_LENGTH=60
MAX_TAGLINE_LENGTH=200

# --- limits -------------------------------------------------------------------

# Sockets held at once, mining or just watching. Measured, not guessed: five thousand
# of them cost this server about 65 MB and left the broadcast loop running on time
# (scripts/load-test.ts). Raise it and re-run that before believing a bigger number.
MAX_CLIENTS=5000
MAX_WS_PAYLOAD_BYTES=16384
MAX_BODY_BYTES=16384

# Largest uploaded icon. The browser redraws every pick onto a 128px canvas before
# sending, so this is headroom over our own encoder, not a budget for arbitrary files.
MAX_ICON_BYTES=65536
MAX_MESSAGES_PER_SECOND=20

# Ceiling on a self-reported hashrate. Nothing can verify this number, so it is capped
# to stop one client claiming the whole board. Scores are unaffected - those come from
# shares the pool accepted.
MAX_REPORTED_HASHRATE=5000000

# New listings allowed per address per minute.
RATE_MAX=5

# Requests per address per minute for the reads that cost real work: the share cards,
# which are rasterised, and /r/:id, which writes a click.
READ_RATE_MAX=60

# Sockets one address may hold at once. MAX_CLIENTS on its own is a single global
# counter, so without this one host can take every slot and lock everyone else out.
#
# One address is not one visitor: a university, an office or a phone network arrives as
# a single address. Behind a proxy this only means anything if TRUSTED_PROXIES is set -
# otherwise every socket carries the proxy's address and the whole site counts as one
# visitor, which caps it at this number.
MAX_CLIENTS_PER_ADDRESS=25

# Longest accepted board search string.
MAX_QUERY_LENGTH=64

# --- security -----------------------------------------------------------------

# Origins allowed to call the API and open a mining socket, comma separated.
# Leave empty and only same-origin requests are accepted, so an unconfigured
# deployment is closed rather than open. This is a security control: without it any
# website could mine on its visitors' CPUs against this pool account, skipping the
# consent banner.
# For local development: ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=

# Words refused in a listing's name or tagline, comma separated. Setting this REPLACES
# the built-in list rather than adding to it - see DEFAULT_BLOCKED_WORDS in config.ts.
# Whole-word and case-insensitive, so "porn" is refused and "popcorn" is not. It is not
# a moderation system: ADMIN_TOKEN below is what actually enforces the rules.
# Leave the line commented out for the built-in list. Setting it empty is the off
# switch, and it is left commented rather than blank so that copying this file does not
# quietly turn the check off.
# BLOCKED_WORDS=

# Required for DELETE /api/listings/:id. Leave empty to disable takedowns entirely.
# Both routes that check it are rate limited, and it is compared in constant time - but
# it is still a password on the open internet, so make it long and random:
#   bun -e 'console.log(crypto.randomUUID().replaceAll("-",""))'
ADMIN_TOKEN=

# Number of proxies in front of this server. X-Forwarded-For is appended to by each
# hop, so with one proxy the client address is the last entry. Left at 0 the header is
# ignored entirely and the socket address is used - trusting the first entry instead
# would let anyone forge their address and walk past the rate limit.
# Behind the edge Caddy - which is the only way this is deployed - set this to 1.
TRUSTED_PROXIES=0

# --- runtime ------------------------------------------------------------------

# Which built image this host runs. Every push to main publishes
# ghcr.io/blvckparrot/outmine:<commit sha>, and the deploy job in
# .github/workflows/image.yml rewrites this line to the one it just built - so on the
# server this is a record of what is running, not a knob you turn.
#
# Turn it by hand to roll back: put an older sha here, then `docker compose pull &&
# docker compose up -d`. Required, and deliberately so - a host that cannot say which
# build it is running cannot go back to the one that worked. The deploy does that for
# itself when a new image fails its healthcheck.
IMAGE_TAG=

DB_PATH=data/outmine.sqlite

# The port the server listens on. One number, one place: the edge stack hands the same
# value to Caddy, so the reverse_proxy upstream, the healthcheck and the exposed port
# all follow this line. Nothing to change but this.
PORT=3000

# Nightly snapshot of the database into ./backups, run by the server process itself.
# Five cron fields, "minute hour day month weekday", in the machine's local time - UTC
# in the image, so this is 04:00 UTC. Empty disables backups. BACKUP_KEEP is how many
# snapshots survive; anything older than the newest 14 is deleted after each run.
BACKUP_CRON=0 4 * * *
BACKUP_KEEP=14

# --- analytics -----------------------------------------------------------------
#
# Self-hosted analytics (rybbit). Both or neither: the tag needs an origin to load
# from and a site to attribute to, and half the pair is a script that 404s on every
# page. Left empty - the default - there is no tag in the document and no extra origin
# in the Content-Security-Policy, which is the policy this ships with.
#
# Configuration rather than a line in index.html because one image serves every
# deployment: baked in at build time it would either be wrong or need a second image,
# and a dev tree would report into production's dashboard.
#
# Both are checked against a shape at startup and a value that does not fit is refused
# rather than trimmed - they are spliced into a <script> tag and into a header.
# Origin: scheme and host only, no trailing slash and no path.
ANALYTICS_ORIGIN=
# The site's id in the analytics dashboard. Letters, digits, dash, underscore.
ANALYTICS_SITE_ID=

# --- error reporting ------------------------------------------------------------
#
# Where a browser error goes. All three or none: the reporter needs an origin to post
# to, an organisation to post into and a token to post with, and two out of three is a
# page that loads a reporter which cannot report. Empty - the default - and nothing is
# loaded at all; the SDK is a separate chunk that is never fetched.
#
# Only connect-src widens for this. The SDK ships in the bundle rather than from a CDN,
# so script-src is untouched.
#
# Server-side errors do not go through here. They are one line of JSON on stdout and
# the host's log collector picks them up - see log.ts, which has no dependency for
# exactly that reason.
OBSERVE_ORIGIN=
OBSERVE_ORG=
# NOT A SECRET, despite the company it keeps in this file. It is written into every
# page, so every visitor has it. Ingest-only: the worst it buys somebody is writing
# junk into a log stream. Rotate it in the OpenObserve UI if that happens. Never put
# an account password here - the shape check would take it and the page would publish
# it.
OBSERVE_PUBLIC_TOKEN=

# Your domain. Read here to derive PUBLIC_ORIGIN below, and again by the edge stack's
# own .env, where it is what Caddy asks Let's Encrypt for - see compose.edge.yml. The
# two have to agree: this one decides what URLs the pages advertise, that one decides
# which hostname actually answers.
SITE_ADDRESS=outmine.example.com

# Absolute origin this site is served from, e.g. https://outmine.example.com. Used
# only for the og:image and og:url tags a crawler reads, which cannot be relative.
# Left empty, the Host header of the request is used, which is correct in development
# and behind a proxy you control.
PUBLIC_ORIGIN=
