# Every value below is optional except POOL_USER. Defaults are in
# packages/server/src/config.ts, which validates them at startup: a mistyped number
# stops the server rather than silently becoming NaN.

# --- pool ---------------------------------------------------------------------

# Payout address. zpool credits accepted shares here - this is where the money lands.
# Any BTC address works; an exchange deposit address is fine. Required: mining to an
# empty user credits nobody and nothing else would complain.
POOL_USER=your-btc-address

# Ports come from https://zpool.ca/api/status
# minotaurx pays the most per browser hash today; re-check with scripts/rank-algos.ts.
POOL_HOST=minotaurx.mine.zpool.ca
POOL_PORT=7019
POOL_PASS=c=BTC

# Miners sharing one pool socket. One socket per miner gets the server's IP banned;
# one socket for everyone runs into vardiff, which targets 5-15 submits per minute per
# connection and would cap the whole site at that rate however many people mine.
MINERS_PER_CONNECTION=16

# Ceiling on sockets held against the pool. Past this, mining is refused rather than
# risking a ban that would stop everyone earning.
MAX_POOL_CONNECTIONS=64

# Jobs remembered per connection, so a share that raced a job switch is dropped
# locally instead of being sent and rejected.
JOB_HISTORY=3

# Consecutive unaccepted submits before a miner is cut off. Counting rejects alone is
# not enough: a pool that has had enough simply stops replying.
MAX_BAD_SUBMITS=10

# --- board --------------------------------------------------------------------

# Shares a listing must accumulate before it appears on the board. This is the whole
# anti-spam mechanism: listing costs the same currency as competing.
VISIBILITY_THRESHOLD=600

BOARD_ENTRIES=50
BOARD_PENDING_ENTRIES=20
BOARD_TRENDING_ENTRIES=10
BOARD_FEED_ENTRIES=15

# How often a changed board is pushed to everyone, and how often in-memory counters
# are written to SQLite.
BOARD_BROADCAST_MS=2000
FLUSH_MS=30000

MAX_NAME_LENGTH=60
MAX_TAGLINE_LENGTH=200

# --- limits -------------------------------------------------------------------

MAX_CLIENTS=2000
MAX_WS_PAYLOAD_BYTES=16384
MAX_BODY_BYTES=16384
MAX_MESSAGES_PER_SECOND=20

# Ceiling on a self-reported hashrate. Nothing can verify this number, so it is capped
# to stop one client claiming the whole board. Scores are unaffected - those come from
# shares the pool accepted.
MAX_REPORTED_HASHRATE=5000000

# New listings allowed per address per minute, and how many addresses are tracked.
RATE_MAX=5
RATE_BUCKETS=10000

# --- security -----------------------------------------------------------------

# Origins allowed to call the API and open a mining socket, comma separated.
# Leave empty and only same-origin requests are accepted, so an unconfigured
# deployment is closed rather than open. This is a security control: without it any
# website could mine on its visitors' CPUs against this pool account, skipping the
# consent banner.
# For local development: ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=

# Required for DELETE /api/listings/:id. Leave empty to disable takedowns entirely.
ADMIN_TOKEN=

# Number of proxies in front of this server. X-Forwarded-For is appended to by each
# hop, so with one proxy the client address is the last entry. Left at 0 the header is
# ignored entirely and the socket address is used - trusting the first entry instead
# would let anyone forge their address and walk past the rate limit.
# Behind the bundled Caddy, set this to 1.
TRUSTED_PROXIES=0

# --- runtime ------------------------------------------------------------------

DB_PATH=data/outmine.sqlite
PORT=3000

# Your domain, used by Caddy for TLS.
SITE_ADDRESS=outmine.example.com

# Absolute origin this site is served from, e.g. https://outmine.example.com. Used
# only for the og:image and og:url tags a crawler reads, which cannot be relative.
# Left empty, the Host header of the request is used, which is correct in development
# and behind a proxy you control.
PUBLIC_ORIGIN=
