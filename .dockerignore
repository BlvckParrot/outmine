# Without this, COPY drags the host's tree into the image and quietly undoes two
# things the Dockerfile works hard at.
#
# packages/wasm/vendor is the one that matters. The wasm stage clones it at pinned
# SHAs and verifies argon2's ref.c by digest, and then `COPY packages/wasm ./` used to
# merge the host's unpinned copy on top - after the sha256sum check had already run.
# build.sh skips every fetch when the directory is already there, so what got compiled
# into the miner every visitor runs was whatever happened to be on the builder's disk.
packages/wasm/vendor
packages/wasm/build

# node_modules are symlinks into version-pinned .bun paths. Copied over a
# `bun install --frozen-lockfile`, they point at whatever the host last resolved -
# which is right until the lockfile moves, and then a dangling symlink at import time.
node_modules
**/node_modules

# Built in the image (web stage), so a host build is stale by definition.
packages/web/dist
packages/web/public/mine-*

# The live database and its WAL. Never belonged in a build context.
data

.git
.env
