{
  "name": "outmine",
  "private": true,
  "license": "GPL-2.0-only",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' --no-orphans --elide-lines=0 dev",
    "build": "bun --filter '*' build",
    "start": "bun --filter @outmine/server start",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "bench": "bun --filter @outmine/wasm bench"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "playwright": "1.61.1",
    "typescript": "^7.0.2"
  }
}
